name: Phase 1A Ops Assistant POC

on:
  schedule:
    - cron: '0 * * * *' # Run hourly
  workflow_dispatch:
    inputs:
      issue_number:
        description: 'GitHub Issue Number to post the report to (e.g. 1)'
        required: true
        default: '1'

permissions:
  contents: read
  issues: write

jobs:
  run-ops-assistant:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v4
        
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests
          
      - name: Run Ops Assistant
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          OPS_ISSUE_NUMBER: ${{ github.event.inputs.issue_number || '1' }}
        run: python ops_assistant_poc.py
